{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)

# Load necessary packages
library(survival)
library(survminer)

# Set working directory (adjust path if needed)
setwd("/Users/jaanmartenhuik/Documents/stat_andmeteadus")

# Load data
data <- read.csv("heart_failure_clinical_records_dataset.csv")

Data Preparation and Factor Creation

{r}
# Convert binary variables to factors with meaningful labels
data$sex <- factor(data$sex, levels = c(0, 1), labels = c("Female", "Male"))
data$diabetes <- factor(data$diabetes, levels = c(0, 1), labels = c("No Diabetes", "Diabetes"))
data$high_blood_pressure <- factor(data$high_blood_pressure, levels = c(0, 1), labels = c("No High BP", "High BP"))
data$anaemia <- factor(data$anaemia, levels = c(0, 1), labels = c("No Anaemia", "Anaemia"))
data$smoking <- factor(data$smoking, levels = c(0, 1), labels = c("Non-Smoking", "Smoking"))

# Categorize creatinine phosphokinase (CPK)
data$cpk_category <- ifelse(data$creatinine_phosphokinase <= 120, "Normal CPK", "High CPK")

# Categorize ejection fraction
data$ejection_fraction_cat <- cut(
  data$ejection_fraction,
  breaks = c(-Inf, 40, 49, Inf),
  labels = c("EF ≤40", "EF 41–49", "EF ≥50"),
  right = TRUE
)

# Categorize serum sodium
data$serum_sodium_cat <- cut(
  data$serum_sodium,
  breaks = c(-Inf, 135, 145, Inf),
  labels = c("Low Sodium (<135 mEq/L)", 
             "Normal Sodium (135-145 mEq/L)", 
             "High Sodium (>145 mEq/L)"),
  right = FALSE
)

# Categorize platelet levels
data$platelet_cat <- cut(
  data$platelets,
  breaks = c(-Inf, 150000, 450000, Inf),
  labels = c("Low Platelets (<150k/mcL)", 
             "Normal Platelets (150k-450k/mcL)", 
             "High Platelets (>450k/mcL)"),
  right = FALSE
)

# Create a single survival object to use for most analyses
surv_object <- Surv(time = data$time, event = data$DEATH_EVENT)


Kaplan-Meier Survival Curve Stratified by Gender

{r}
# Fit Kaplan-Meier survival curves
km_fit_sex <- survfit(surv_object ~ sex, data = data)

# Log-rank test
log_rank_sex <- survdiff(surv_object ~ sex, data = data)
print(log_rank_sex)

# Plot Kaplan-Meier curves
ggsurvplot(
  km_fit_sex,
  data = data,
  pval = TRUE,
  pval.coord = c(10, 0.5),
  title = "Kaplan-Meier Survival Curve Stratified by Gender",
  xlab = "Time (days)",
  ylab = "Survival Probability",
  legend.title = "Gender",
  legend.labs = c("Female", "Male"),
  ggtheme = theme_bw()
)


