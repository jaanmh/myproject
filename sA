Cox Proportional Hazards Model (Selected Predictors)

{r}
# Fit a Cox Proportional Hazards model with selected predictors
cph_model <- coxph(Surv(time, DEATH_EVENT) ~ high_blood_pressure + anaemia + smoking + diabetes, data = data)

# Display the summary of the Cox model
summary(cph_model)

# Forest plot of hazard ratios
ggforest(
  cph_model, 
  data = data, 
  main = "Forest Plot of Hazard Ratios", 
  cpositions = c(0.02, 0.22, 0.4), 
  fontsize = 0.8
)


Cox Proportional Hazards Model (All Predictors)

{r}
# Fit a Cox Proportional Hazards model including all predictors
cph_model_full <- coxph(
  Surv(time, DEATH_EVENT) ~ 
    age + anaemia + diabetes + ejection_fraction_cat + 
    high_blood_pressure + platelet_cat + serum_sodium_cat + 
    sex + smoking + cpk_category, 
  data = data
)

# Display the summary of the Cox model
summary(cph_model_full)

# Forest plot of adjusted hazard ratios
ggforest(
  cph_model_full, 
  data = data, 
  main = "Forest Plot of Adjusted Hazard Ratios",
  cpositions = c(0.02, 0.22, 0.4),
  fontsize = 0.8
)


